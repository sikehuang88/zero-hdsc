# SSA — Digital Lifeform Prototype
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# === Secrets (required for full runtime) ===
SSA_LLM_API_KEY=sk-your-deepseek-key
SSA_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
SSA_EXPORT_PASSWORD=choose-a-strong-password

# === Telegram single-user lock ===
SSA_TELEGRAM_USER_ID=0

# === Behavior / experiment params (version-controlled defaults in config/) ===
SSA_TIMEZONE=Asia/Shanghai
SSA_LLM_MODEL=deepseek/deepseek-chat
SSA_LLM_TEMPERATURE=0.8
SSA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SSA_EMBEDDING_DIM=512
SSA_RETRIEVAL_CANDIDATES=50
SSA_RETRIEVAL_FINAL_K=8
SSA_INITIATIVE_DAILY_LIMIT=3
SSA_INITIATIVE_COOLDOWN_MINUTES=240
SSA_BACKGROUND_DAILY_LLM_BUDGET=20
SSA_QUIET_HOURS_START=23:00
SSA_QUIET_HOURS_END=07:00
