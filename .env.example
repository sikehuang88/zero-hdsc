# HDSC — Hyperdimensional Space Computing
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# Legacy SSA_* names remain accepted during the compatibility period.

# === Secrets (required for full runtime) ===
HDSC_LLM_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key
HDSC_MULTIMODAL_API_KEY=sk-your-magicai-key
# MAGICAI_API_KEY=sk-your-magicai-key
HDSC_FIRECRAWL_API_KEY=fc-your-firecrawl-key
# FIRECRAWL_API_KEY=fc-your-firecrawl-key
HDSC_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
HDSC_EXPORT_PASSWORD=choose-a-strong-password

# === Telegram single-user lock ===
HDSC_TELEGRAM_USER_ID=0

# === Behavior / experiment params (version-controlled defaults in config/) ===
HDSC_TIMEZONE=Asia/Shanghai
# Model ids are free-form: known DeepSeek V4 ids are normalized, everything
# else is passed through to the provider exactly as entered.
HDSC_LLM_MODEL=deepseek/deepseek-v4-flash
HDSC_LLM_REASONING_MODEL=deepseek/deepseek-v4-pro
HDSC_LLM_BASE_URL=https://api.deepseek.com
HDSC_LLM_BETA_BASE_URL=https://api.deepseek.com/beta
# Optional Anthropic-compatible gateway for the anthropic/* routes
# (newapi-style gateways exposing /v1/messages). To switch the reasoning model
# to this provider, also set:
#   HDSC_LLM_REASONING_MODEL=anthropic/DeepSeek-V4-Pro
# Plain ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN names are accepted as aliases.
# HDSC_LLM_ANTHROPIC_BASE_URL=https://pool.chaozhiyuanai.com/
# HDSC_ANTHROPIC_AUTH_TOKEN=sk-your-anthropic-gateway-token
HDSC_LLM_TEMPERATURE=0.8
# HDSC_LLM_TOP_P=0.95  # use instead of HDSC_LLM_TEMPERATURE, not together
HDSC_LLM_MAX_TOKENS=1024
HDSC_LLM_TIMEOUT_SECONDS=120
HDSC_LLM_RETRY_COUNT=2
HDSC_LLM_JSON_RETRY_COUNT=1
HDSC_LLM_THINKING_MODE=disabled
HDSC_LLM_REASONING_EFFORT=high
HDSC_DEEPSEEK_USER_ID=hdsc-primary
HDSC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HDSC_EMBEDDING_DIM=512
HDSC_RETRIEVAL_CANDIDATES=50
HDSC_RETRIEVAL_FINAL_K=8
# H2 bounded active-space shadow; no prompt effect.
HDSC_H2_SHADOW_ENABLED=true
HDSC_H2_ACTIVE_CAPACITY=8
HDSC_H2_CANDIDATE_TOP_K=4
HDSC_H2_CLUSTER_BITS=16
HDSC_H2_RETENTION=0.80
HDSC_H2_INJECTION_RATE=0.15
HDSC_H2_HYSTERESIS=0.02
HDSC_H2_SCORE_LIPSCHITZ_BOUND=1.0
HDSC_H2_GAIN_MARGIN=0.05
HDSC_H2_MASS_TOLERANCE=1e-10
HDSC_INITIATIVE_DAILY_LIMIT=3
HDSC_INITIATIVE_COOLDOWN_MINUTES=240
HDSC_BACKGROUND_DAILY_LLM_BUDGET=20
HDSC_IDENTITY_REVIEW_INTERVAL_AGENT_EVENTS=4
HDSC_IDENTITY_REVIEW_WINDOW_EVENTS=24
HDSC_MIN_OUTCOME_CONFIDENCE=1.2
HDSC_TOOLS_ENABLED=true
HDSC_TOOLS_MAX_ROUNDS=8
HDSC_TOOLS_DEFAULT_TIMEOUT_SECONDS=60
HDSC_TOOLS_MAX_OUTPUT_CHARS=32000
HDSC_TOOLS_ALLOW_ELEVATION=true
HDSC_WIN32_ENABLED=true
HDSC_WIN32_CLIPBOARD_ENABLED=true
HDSC_WIN32_MAX_WINDOWS=64
HDSC_WIN32_MAX_PROCESSES=128
HDSC_WIN32_MAX_DIRECTORY_ENTRIES=256
HDSC_WIN32_MAX_CLIPBOARD_CHARS=16000
HDSC_EXTERNAL_TRUTH_ENABLED=true
HDSC_EXTERNAL_TRUTH_SOURCES=weather,sun_times,holidays,geocode,news,radio,music,translate,service_status
HDSC_EXTERNAL_TRUTH_TIMEOUT_SECONDS=12
HDSC_EXTERNAL_TRUTH_CACHE_TTL_SECONDS=300
HDSC_EXTERNAL_TRUTH_MAX_RESPONSE_BYTES=524288
HDSC_EXTERNAL_TRUTH_MIN_REQUEST_INTERVAL_MS=1100
HDSC_FIRECRAWL_ENABLED=true
HDSC_FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
HDSC_FIRECRAWL_TIMEOUT_SECONDS=60
HDSC_FIRECRAWL_MAX_RESPONSE_BYTES=4194304
HDSC_FIRECRAWL_MAX_RESULT_CONTENT_CHARS=8000
HDSC_MULTIMODAL_ENABLED=true
HDSC_MULTIMODAL_MODEL=gpt-5.6-luna
HDSC_MULTIMODAL_BASE_URL=https://sky1818.com/v1
HDSC_MULTIMODAL_REASONING_EFFORT=medium
HDSC_MULTIMODAL_TIMEOUT_SECONDS=180
HDSC_MULTIMODAL_MAX_FILES=8
HDSC_MULTIMODAL_MAX_FILE_BYTES=20971520
HDSC_MULTIMODAL_MAX_TOTAL_BYTES=41943040
# Optional authored emotion-expression library directory.
HDSC_EMOTION_LIBRARY_ROOT=emotion-value-library
HDSC_QUIET_HOURS_START=23:00
HDSC_QUIET_HOURS_END=07:00
